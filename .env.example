# CTK Build Configuration
# Copy this file to .env and customize the paths for your system

# Dependency paths
OPENCV_DIR=<FULL_PATH_TO_OPENCV_BUILD>
GTEST_DIR=<FULL_PATH_TO_GTEST_INSTALL>/lib/cmake/GTest
BENCHMARK_DIR=<FULL_PATH_TO_BENCHMARK_INSTALL>/lib/cmake/benchmark

# Build directories (relative to project root)
BUILD_DIR_MSVC=build-msvc
BUILD_DIR_CLANG=build-clang

# Install prefix (optional, uncomment to use)
# INSTALL_PREFIX=<FULL_PATH_TO_CTK_BUILD>/install

# Number of parallel build jobs (optional, defaults to CPU count)
# BUILD_JOBS=8

# CMake generator for MSVC (optional, auto-detected)
# CMAKE_GENERATOR_MSVC=Visual Studio 17 2022

# Compiler paths (optional, auto-detected from PATH)
# CLANG_C_COMPILER=C:/Program Files/LLVM/bin/clang.exe
# CLANG_CXX_COMPILER=C:/Program Files/LLVM/bin/clang++.exe
